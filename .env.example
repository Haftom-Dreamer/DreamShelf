# ====================================================
# DreamShelf Environment Configuration Template
# Copy this file to .env and replace with your secrets
# ====================================================

# --- Flask Core Settings ---
SECRET_KEY=replace_with_a_secure_random_key_here
FLASK_DEBUG=True
PORT=5000

# --- Database (Optional: defaults to local favorite-movies.db) ---
# DATABASE_URL=postgresql://username:password@localhost:5432/dreamshelf

# --- TMDB API ---
# Obtain for free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# --- Google OAuth 2.0 Credentials (Optional) ---
# Setup at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

